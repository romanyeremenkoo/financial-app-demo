# Copy to .env and adjust for your machine. Never commit real secrets.
# These values are read by docker-compose.yml and can be exported for the API.

# PostgreSQL connection used by the Spring Boot app.
DB_URL=jdbc:postgresql://localhost:5432/financial_app
DB_USERNAME=financial_app
DB_PASSWORD=change-me-in-local-dev

# Password the docker-compose Postgres container is initialised with.
# Keep this in sync with DB_PASSWORD.
POSTGRES_PASSWORD=change-me-in-local-dev

# Comma-separated list of browser origins allowed by CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4280,http://localhost:5173,http://localhost:5273
