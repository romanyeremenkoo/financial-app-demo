{
  "name": "pet-project-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "ng serve --configuration api",
    "build": "ng build",
    "postbuild": "node tools/strip-cf-asset-config.mjs",
    "build:api": "ng build --configuration api",
    "postbuild:api": "node tools/strip-cf-asset-config.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.cypress.json",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "e2e": "npm run e2e:pw && npm run e2e:cy",
    "e2e:pw": "playwright test",
    "e2e:cy": "start-server-and-test serve:e2e http://localhost:4280 \"cypress run\"",
    "e2e:cy:open": "start-server-and-test serve:e2e http://localhost:4280 \"cypress open --e2e --browser electron\"",
    "serve:e2e": "ng serve --port 4280",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@ngneat/spectator": "^22.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.6.0",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
