# Data access mode for the React frontend.
#
#   demo -> deterministic fictional data generated in the browser and persisted
#           in localStorage. No backend required. This is the default and the
#           only mode used by the public static deployment.
#   api  -> every read and write goes to the shared Spring Boot service.
#
# VITE_* values are inlined into the client bundle. Never put a secret here.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://localhost:8080/api
