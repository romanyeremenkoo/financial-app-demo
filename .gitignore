# ---------------------------------------------------------------------------
# Financial App monorepo — root ignore rules.
# Per-project rules live in app/angular-web/.gitignore and
# services/banking-api/.gitignore.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out-tsc/
target/
.angular/cache/
.vite/
*.tsbuildinfo

# Test + coverage output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
__screenshots__/
e2e/cypress/artifacts/
cypress/videos/
cypress/screenshots/

# Local environment files (templates such as .env.example stay tracked)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Local databases / data volumes
*.sqlite
*.db
.pgdata/
